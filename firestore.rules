rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── 1. Notes & Surprises (Client + Recipient Access) ──
    // Allows reading notes, creating new ones, and updating view counts / reactions
    match /notes/{token} {
      allow read, create, update: if true;
      allow delete: if request.auth != null && resource.data.creator_uid == request.auth.uid;
    }

    // ── 2. Public Content Collections ──
    // Coupons: Client can check promo codes
    match /coupons/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Blog Posts: Publicly readable for SEO & Blog pages
    match /blog/{id} {
      allow read: if true;
      allow write: if false;
    }
    match /blogs/{id} {
      allow read: if true;
      allow write: if false;
    }

    // Public Challenges / Leaderboards
    match /challenges/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── 3. Referral Tracking ──
    // Allows client to log referral clicks anonymously
    match /referralClicks/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // ── 4. Server-Only & Admin Collections (Firebase Admin SDK Only) ──
    // These collections are accessed exclusively via Next.js Server / API routes using Admin SDK.
    // Client SDK access is completely blocked for security.
    match /creators/{id} { allow read, write: if false; }
    match /creatorTiers/{id} { allow read, write: if false; }
    match /creatorGifts/{id} { allow read, write: if false; }
    match /creatorApplications/{id} { allow read, write: if false; }
    match /orders/{id} { allow read, write: if false; }
    match /admin_payment_ledger/{id} { allow read, write: if false; }
    match /commissions/{id} { allow read, write: if false; }
    match /payouts/{id} { allow read, write: if false; }
    match /crm/{id} { allow read, write: if false; }
    match /analytics/{id} { allow read, write: if false; }

    // ── Corporate Business Ecosystem (Server / Firebase Admin SDK Only) ──
    match /business_applications/{id} { allow read, write: if false; }
    match /businesses/{id} { allow read, write: if false; }
    match /business_users/{id} { allow read, write: if false; }
    match /business_invitations/{id} { allow read, write: if false; }
    match /business_employees/{id} { allow read, write: if false; }
    match /business_occasion_tasks/{id} { allow read, write: if false; }
    match /business_experiences/{id} { allow read, write: if false; }
    match /business_recipient_links/{id} { allow read, write: if false; }
    match /business_usage_ledger/{id} { allow read, write: if false; }
    match /business_audit_logs/{id} { allow read, write: if false; }

    // ── 5. Default Catch-All Block ──
    // Blocks unauthorized access to any unlisted collection
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

